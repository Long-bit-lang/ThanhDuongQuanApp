<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Fullscreen POS Web Interface -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status & Quick Config Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPrinterStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Đang kết nối máy in..." />

        <Button
            android:id="@+id/btnTestPrint"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textSize="11sp"
            android:text="In thử USB"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnConfigServer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textSize="11sp"
            android:text="Cài đặt URL" />
    </LinearLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
