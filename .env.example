# Environment: development | production | testing
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-insecure-secret-key-change-in-production-min32chars

# PostgreSQL Database Configuration
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password
POSTGRES_DB=thanh_duong_pos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URLs
DATABASE_URL=postgresql+asyncpg://pos_user:pos_password@localhost:5432/thanh_duong_pos
SYNC_DATABASE_URL=postgresql+psycopg://pos_user:pos_password@localhost:5432/thanh_duong_pos

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

VITE_WS_URL=ws://localhost:8000
